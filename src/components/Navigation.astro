---
import L from './L.astro';
import { defaultLang, languages, langs } from '@/i18n/ui';
import { i18nAttrs, tt } from '@/i18n/utils';

const navLinks = [
  { href: '/woodworking', label: tt('category.Woodworking') },
  { href: '/renovation', label: tt('category.Renovation') },
  { href: '/garden', label: tt('category.Garden') },
  { href: '/gallery', label: tt('nav.allWork') },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 min-w-[320px] bg-ink/95 backdrop-blur-sm border-b-[3px] border-double border-paper-line px-8 lg:px-12">
  <nav class="max-w-6xl mx-auto">
    <!-- Eyebrow row -->
    <div class="hidden sm:flex justify-end items-center gap-6 py-2 border-b border-paper-line-soft">
      <span class="label !text-brown-soft !tracking-[0.28em] !text-[0.78rem]"><L text={tt('nav.location')} /></span>
      <ul class="flex items-center gap-2" {...i18nAttrs({ 'aria-label': tt('nav.switchLanguage') })}>
        {langs.map((code, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span class="text-brown-soft text-[0.78rem]" aria-hidden="true">/</span>}
            <button
              type="button"
              data-set-lang={code}
              lang={code}
              title={languages[code]}
              aria-pressed={String(code === defaultLang)}
              class="label cursor-pointer !tracking-[0.2em] !text-[0.78rem] !text-brown-soft hover:!text-paper aria-pressed:!text-paper transition-colors duration-300"
            >
              {code.toUpperCase()}
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center justify-between h-16 sm:h-[4.5rem]">
      <!-- Wordmark -->
      <a href="/" class="group flex items-center leading-none">
        <span class="font-display font-bold text-2xl sm:text-[1.7rem] tracking-[0.02em] whitespace-nowrap">
          <span class="text-paper">Cardo</span> <span class="text-brown-soft">Tisler</span>
        </span>
      </a>

      <!-- Desktop navigation -->
      <ul class="hidden md:flex items-end gap-7 lg:gap-9">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'nav-link text-paper text-[0.7rem] tracking-normal',
                { 'is-active': currentPath === link.href },
              ]}
            >
              <L text={link.label} />
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-paper"
        {...i18nAttrs({ 'aria-label': tt('nav.toggleMenu') })}
      >
        <div class="w-6 h-5 flex flex-col justify-between" id="hamburger">
          <span class="w-full h-px bg-current transition-all duration-300 origin-center"></span>
          <span class="w-4 h-px bg-brown-soft transition-all duration-300 ml-auto"></span>
          <span class="w-full h-px bg-current transition-all duration-300 origin-center"></span>
        </div>
      </button>
    </div>

    <!-- Mobile navigation -->
    <div id="mobile-menu" class="hidden md:hidden">
      <div class="py-6 border-t border-paper-line-soft">
        <ul class="space-y-4">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'block py-2 font-display text-lg uppercase tracking-[0.14em] transition-colors duration-300',
                  currentPath === link.href
                    ? 'text-paper'
                    : 'text-brown-soft hover:text-paper',
                ]}
              >
                <L text={link.label} />
              </a>
            </li>
          ))}
        </ul>
        <ul class="flex items-center gap-5 mt-6 pt-5 border-t border-paper-line-soft" {...i18nAttrs({ 'aria-label': tt('nav.switchLanguage') })}>
          {langs.map((code) => (
            <li>
              <button
                type="button"
                data-set-lang={code}
                lang={code}
                aria-pressed={String(code === defaultLang)}
                class="block py-1 cursor-pointer font-display text-sm uppercase tracking-[0.14em] text-brown-soft hover:text-paper aria-pressed:text-paper transition-colors duration-300"
              >
                {languages[code]}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger');
  let isOpen = false;

  btn?.addEventListener('click', () => {
    isOpen = !isOpen;
    menu?.classList.toggle('hidden');

    const spans = hamburger?.querySelectorAll('span');
    if (spans && isOpen) {
      spans[0].style.transform = 'translateY(9px) rotate(45deg)';
      spans[1].style.opacity = '0';
      spans[2].style.transform = 'translateY(-9px) rotate(-45deg)';
    } else if (spans) {
      spans[0].style.transform = '';
      spans[1].style.opacity = '1';
      spans[2].style.transform = '';
    }
  });
</script>
