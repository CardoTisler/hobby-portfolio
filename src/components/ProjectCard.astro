---
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';
import { toRoman } from '@/lib/utils';

interface Props {
  title: string;
  category: string;
  thumbnail: ImageMetadata;
  slug: string;
  index?: number;
  total?: number;
  showNumeral?: boolean;
}

const { title, category, thumbnail, slug, index = 0, total = 1, showNumeral = true } = Astro.props;
const numeral = showNumeral ? toRoman(total - index) : '';
---

<a
  href={`/${category.toLowerCase()}/${slug}`}
  class="group block mb-6 lg:mb-8 break-inside-avoid"
>
  <article class="specimen">
    <div class="plate">
      {showNumeral && numeral && (
        <span class="plate-no">{numeral}</span>
      )}
      <Photo
        src={thumbnail}
        alt={title}
        width={900}
        class="w-full h-auto block transition-transform duration-500 ease-out group-hover:scale-[1.02]"
      />
    </div>

    <span class="label block mt-3.5">{category}</span>
    <h3 class="font-display font-bold text-ink text-[1.3rem] leading-[1.16] mt-1.5 tracking-[0.01em] transition-colors duration-300 group-hover:text-brown">
      {title}
    </h3>
  </article>
</a>
