---
interface Props {
  title: string;
  description: string;
  projectCount: number;
}

const { title, description, projectCount } = Astro.props;
---

<div class="pt-36 sm:pt-44 pb-10 px-8 lg:px-12">
  <div class="max-w-6xl mx-auto">
    <!-- Back link -->
    <a
      href="/"
      class="inline-flex items-center gap-2 font-display uppercase text-[0.85rem] tracking-[0.16em] text-brown-mid hover:text-ink transition-colors duration-300 mb-10"
    >
      <span aria-hidden="true">←</span><span>Home</span>
    </a>

    <!-- Centered title block -->
    <div class="text-center">
      <p class="label mb-4">Catalogue of Works</p>

      <h1 class="font-display font-bold text-ink leading-[1.05] tracking-[0.005em] text-[clamp(2.4rem,5.5vw,4rem)]">
        {title}
      </h1>

      {description && (
        <p class="mt-4 text-brown max-w-[50ch] mx-auto leading-relaxed">
          {description}
        </p>
      )}

      <p class="font-mono text-[0.85rem] tracking-[0.05em] text-brown-soft mt-5">
        {projectCount} {projectCount === 1 ? 'project' : 'projects'} recorded
      </p>

      <div class="ornament max-w-[300px] mx-auto mt-6">
        <span class="mark">&#10048;</span>
      </div>
    </div>
  </div>
</div>
