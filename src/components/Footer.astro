---
import { Image } from 'astro:assets';
import logo from '@/assets/logo-white.svg';
---

<footer class="mt-auto bg-ink border-t-[3px] border-double border-paper-line">
  <div class="flex justify-center py-5 px-8">
    <Image
      src={logo}
      alt="Cardo Tisler"
      height={280}
      class="h-40 w-auto opacity-90"
    />
  </div>
</footer>
