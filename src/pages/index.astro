---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import L from '@/components/L.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import { getProjects } from '@/lib/projects';
import { tt } from '@/i18n/utils';

const allProjects = await getProjects();
const recentProjects = allProjects.slice(0, 6);
---

<Layout title="Cardo Tisler">
  <Hero />

  <!-- Recent Work -->
  <section class="pt-2 pb-24 px-8 lg:px-12">
    <div class="max-w-6xl mx-auto">
      <!-- Section header -->
      <div class="flex items-baseline justify-between gap-6 flex-wrap">
        <h2 class="font-display font-bold text-ink tracking-[0.01em] text-[28px] whitespace-nowrap">
          <L text={tt('home.recentWork')} />
        </h2>

        {allProjects.length > 6 && (
          <a
            href="/gallery"
            class="font-display font-bold uppercase text-[0.85rem] tracking-[0.16em] text-brown border-b border-line pb-0.5 transition-colors duration-300 hover:text-ink hover:border-ink"
          >
            <L text={tt('home.viewAll')} />
          </a>
        )}
      </div>

      <hr class="rule mt-3" />

      <div class="mt-8">
        <ProjectGrid
          projects={recentProjects}
          emptyMessage={tt('home.empty')}
          showNumerals={false}
        />
      </div>
    </div>
  </section>
</Layout>
