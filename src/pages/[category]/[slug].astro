---
import { render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Photo from '@/components/Photo.astro';
import BeforeAfterSlider from '@/components/BeforeAfterSlider.astro';
import ImageCarousel from '@/components/ImageCarousel.astro';
import CostSummary from '@/components/CostSummary.astro';
import ProgressTimeline from '@/components/ProgressTimeline.astro';
import L from '@/components/L.astro';
import { getProjects, type BilingualProject } from '@/lib/projects';
import { dateLocales } from '@/i18n/ui';
import { both, i18nAttrs, tt } from '@/i18n/utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: {
      category: project.data.category.toLowerCase(),
      slug: project.id,
    },
    props: { project },
  }));
}

interface Props {
  project: BilingualProject;
}

const { project } = Astro.props;
const { Content: ContentEt } = await render(project.content.et);
const { Content: ContentEn } = await render(project.content.en);
const category = project.data.category.toLowerCase();
const title = both((lang) => project.text[lang].title);
const field = (name: 'material' | 'finish' | 'dimensions') => both((lang) => project.text[lang][name] ?? '');

const hasBeforeAfter = project.data.beforeImage && project.data.afterImage;
const hasDetails = project.data.date || project.data.material || project.data.dimensions || project.data.finish;

const completed = project.data.date && both((lang) =>
  project.data.date!.toLocaleDateString(dateLocales[lang], {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  })
);

// Glob all project images at build time for directory-based progress steps
const allProjectImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

// Resolve progress steps: use explicit `images` if provided, otherwise
// discover images from `imagesDir` by filtering the glob results
const resolvedProgress = project.data.progress?.map((step, i) => {
  const text = {
    leftTitle: both((lang) => project.text[lang].progress![i].leftTitle),
    rightTitle: both((lang) => project.text[lang].progress![i].rightTitle),
    description: both((lang) => project.text[lang].progress![i].description),
  };

  if (step.images && step.images.length > 0) {
    return { ...text, images: step.images };
  }

  if (step.imagesDir) {
    const dirPrefix = `/src/assets/projects/${project.id}/${step.imagesDir}/`;
    const images = Object.entries(allProjectImages)
      .filter(([path]) => path.startsWith(dirPrefix))
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([, mod]) => mod.default);
    return { ...text, images };
  }

  return { ...text, images: [] as ImageMetadata[] };
});
---

<Layout title={both((lang) => `${title[lang]} — Cardo Tisler`)}>
  <article class="pt-36 sm:pt-44 pb-24">
    <!-- Entry header -->
    <div class="px-8 lg:px-12">
      <div class="max-w-6xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="font-display font-bold uppercase text-[0.85rem] tracking-[0.16em] text-brown-mid flex gap-2.5 items-center flex-wrap">
          <a href="/" class="border-b border-transparent hover:text-ink hover:border-line transition-colors duration-200"><L text={tt('listing.breadcrumbHome')} /></a>
          <span class="text-brown-soft" aria-hidden="true">/</span>
          <a href={`/${category}`} class="border-b border-transparent hover:text-ink hover:border-line transition-colors duration-200"><L text={tt(`category.${project.data.category}`)} /></a>
          <span class="text-brown-soft" aria-hidden="true">/</span>
          <span class="text-brown"><L text={title} /></span>
        </nav>

        <header class="mt-6">
          <h1 class="font-display font-bold text-ink leading-[1.02] tracking-[0.005em] text-[28px]">
            <L text={title} />
          </h1>
        </header>
      </div>
    </div>

    <!-- Hero plate / before-after -->
    <div class="px-8 lg:px-12 mt-10 mb-14">
      <div class="max-w-6xl mx-auto">
        {hasBeforeAfter ? (
          <BeforeAfterSlider
            beforeImage={project.data.beforeImage!}
            afterImage={project.data.afterImage!}
            title={title}
          />
        ) : (
          <div class="plate w-full sm:aspect-[16/10] sm:max-h-[70svh]">
            <Photo
              src={project.data.thumbnail}
              {...i18nAttrs({ alt: title })}
              widths={[1400, 2000, 2800]}
              class="block w-full h-auto max-h-[70svh] object-contain sm:h-full"
            />
          </div>
        )}
      </div>
    </div>

    <!-- Body: prose + specifications ledger -->
    <div class="px-8 lg:px-12">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-12 gap-x-12 gap-y-12">
          <div class="lg:col-span-7">
            <div class="entry-prose dropcap text-ink text-[1.06rem]">
              <L as="div">
                <ContentEt slot="et" />
                <ContentEn slot="en" />
              </L>
            </div>

            {project.data.images && project.data.images.length > 0 && (
              <div class="mt-10">
                <ImageCarousel
                  images={project.data.images}
                  title={title}
                />
              </div>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="lg:col-span-4 lg:col-start-9">
            <div class="sticky top-36 space-y-6">
              {hasDetails && (
                <div class="spec">
                  <p class="spec-cap"><L text={tt('project.specifications')} /></p>
                  <dl>
                    {project.data.material && (
                      <div class="pair"><dt><L text={tt('project.material')} /></dt><dd><L text={field('material')} /></dd></div>
                    )}
                    {project.data.finish && (
                      <div class="pair"><dt><L text={tt('project.finish')} /></dt><dd><L text={field('finish')} /></dd></div>
                    )}
                    {project.data.dimensions && (
                      <div class="pair"><dt><L text={tt('project.dimensions')} /></dt><dd><L text={field('dimensions')} /></dd></div>
                    )}
                    {completed && (
                      <div class="pair"><dt><L text={tt('project.completed')} /></dt><dd><L text={completed} /></dd></div>
                    )}
                  </dl>
                </div>
              )}

              {project.data.costs && project.data.costs.length > 0 && (
                <CostSummary
                  costs={project.data.costs.map((cost, i) => ({
                    cost: cost.cost,
                    item: both((lang) => project.text[lang].costs![i].item),
                  }))}
                />
              )}
            </div>
          </aside>
        </div>
      </div>
    </div>

    {/* Progress Timeline — full-width, below main grid */}
    {resolvedProgress && resolvedProgress.length > 0 && (
      <div class="px-8 lg:px-12 mt-24">
        <div class="max-w-6xl mx-auto">
          <ProgressTimeline
            steps={resolvedProgress}
            projectTitle={title}
          />
        </div>
      </div>
    )}
  </article>
</Layout>

<style>
  .entry-prose :global(p) {
    margin: 0 0 1.1em;
  }
  .entry-prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .entry-prose :global(a) {
    color: var(--color-brown);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .entry-prose :global(a:hover) {
    color: var(--color-ink);
  }
  .entry-prose :global(strong) {
    font-weight: 700;
    color: var(--color-ink);
  }
  .entry-prose :global(h2),
  .entry-prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.2;
    margin: 1.6em 0 0.4em;
  }
</style>
