---
import Layout from '@/layouts/Layout.astro';
import CategoryHeader from '@/components/CategoryHeader.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import { getProjects } from '@/lib/projects';
import { both, tt } from '@/i18n/utils';

const sortedProjects = await getProjects(({ category }) => category === 'Renovation');
const title = tt('category.Renovation');
---

<Layout title={both((lang) => `${title[lang]} — Cardo Tisler`)}>
  <CategoryHeader
    title={title}
    projectCount={sortedProjects.length}
  />

  <section class="pb-24 px-8 lg:px-12">
    <div class="max-w-6xl mx-auto">
      <ProjectGrid
        projects={sortedProjects}
        emptyMessage={tt('listing.empty')}
        showNumerals={false}
      />
    </div>
  </section>
</Layout>
